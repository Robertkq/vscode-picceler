{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "picceler",
  "scopeName": "source.picceler",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
	{ "include": "#builtins" },
    { "include": "#strings" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.picceler",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.fn.picceler",
          "match": "\\bdef\\b"
        },
        {
          "name": "keyword.control.picceler",
          "match": "\\breturn\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.picceler",
          "match": "\\b(int64|float64|string|image|kernel)\\b"
        }
      ]
    },
	"builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.io.picceler",
          "match": "\\b(load_image|save_image|show_image|print|read_string|read_number)\\b"
        },
        {
          "name": "support.function.builtin.math.picceler",
          "match": "\\b(sqrt|pow)\\b"
        },
        {
          "name": "support.function.builtin.filter.picceler",
          "match": "\\b(brightness|invert|sharpen|box_blur|gaussian_blur|edge_detect|emboss|rotate)\\b"
        },
        {
          "name": "support.function.builtin.algo.picceler",
          "match": "\\b(convolution|erode|dilate|diff|blend|crop)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.picceler",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.picceler",
          "match": "\\\\."
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.picceler",
          "match": "="
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.picceler",
          "match": ","
        }
      ]
    }
  }
}